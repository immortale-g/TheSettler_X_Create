<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="190 244">
    <!-- MineColonies' layoutfilterablelist.xml with room for one explanation, and a row button wide
         enough to say allowed or forbidden instead of on and off. The ids are theirs:
         ItemListModuleWindow looks for desc, input, resources and resetDefault by name. -->
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <text id="desc" size="130 11" pos="30 14" color="black" textalign="MIDDLE"/>
    <input id="input" size="150 18" pos="20 30" maxlength="25"/>

    <text id="deniedInfo" size="164 45" pos="13 50" textalign="MIDDLE_LEFT" color="black"
          label="$(com.thesettler_x_create.gui.createshop.coloniesmaydraw.info)"/>

    <list id="resources" size="164 88" pos="13 98">
        <box size="100% 17" linewidth="1">
            <itemicon id="resourceIcon" size="16 16" pos="0 0"/>
            <text id="resourceName" size="78 12" pos="20 1" color="black"/>
            <button label="$(com.thesettler_x_create.gui.createshop.coloniesmaydraw.allowed)" id="switch" pos="99 1" size="64 15"
                         source="minecolonies:textures/gui/builderhut/builder_button_small.png" color="black"/>
        </box>
    </list>
    <button label ="$(com.minecolonies.coremod.gui.workerhuts.resetdefault)" id="resetDefault" size="86 17" pos="50 194"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium.png" color="black"/>
</window>
