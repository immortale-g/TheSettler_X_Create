{
  "_comment": [
    "Sets of jars a comparison can run against. 'version' is filled from gradle.properties,",
    "'version_pattern' picks the newest release matching it, so a target stays current on its",
    "own. 'naming' says whether the jars name vanilla methods the SRG way and need translating.",
    "Create Factory Logistics is absent on purpose: the shop reaches it reflectively, so it",
    "leaves no bytecode references for these comparisons to follow. testFactoryLogistics covers it."
  ],

  "current": {
    "minecraft_version": "1.21.1",
    "naming": "mojang",
    "jars": [
      {"repository": "modrinth", "artifact": "create", "version": "{create_version}"},
      {"repository": "ldtteam", "artifact": "minecolonies", "version": "{minecolonies_version}"},
      {"repository": "ldtteam", "artifact": "structurize", "version": "{structurize_version}"},
      {"repository": "ldtteam", "artifact": "blockui", "version": "{blockui_version}"}
    ]
  },

  "latest-1.21.1": {
    "minecraft_version": "1.21.1",
    "naming": "mojang",
    "jars": [
      {"repository": "modrinth", "artifact": "create", "version_pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\+mc1\\.21\\.1$"},
      {"repository": "ldtteam", "artifact": "minecolonies", "version_pattern": "^1\\.1\\.[0-9]+-1\\.21\\.1$"},
      {"repository": "ldtteam", "artifact": "structurize", "version_pattern": "^1\\.0\\.[0-9]+-1\\.21\\.1$"},
      {"repository": "ldtteam", "artifact": "blockui", "version_pattern": "^1\\.0\\.[0-9]+-1\\.21\\.1$"}
    ]
  },

  "1.20.1": {
    "minecraft_version": "1.20.1",
    "naming": "srg",
    "jars": [
      {"repository": "modrinth", "artifact": "create", "version_pattern": "^mc1\\.20\\.1-6\\."},
      {"repository": "ldtteam", "artifact": "minecolonies", "version_pattern": "^1\\.20\\.1-1\\.1\\.[0-9]+$"},
      {"repository": "ldtteam", "artifact": "structurize", "version_pattern": "^1\\.20\\.1-1\\.0\\.[0-9]+$"},
      {"repository": "ldtteam", "artifact": "blockui", "version_pattern": "^1\\.20\\.1-1\\.0\\.[0-9]+$"}
    ]
  }
}
